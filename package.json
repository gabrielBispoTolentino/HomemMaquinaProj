{
  "name": "archivist",
  "productName": "Archivist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "build:mobile": "bun run build.ts \"--env=VITE_*\" && cap sync",
    "android": "bun run build:mobile && cap open android",
    "ios": "bun run build:mobile && cap open ios",
    "build:desktop": "bun run build.ts --sourcemap=none",
    "dist:win": "bun run build:desktop && electron-builder --win --publish never",
    "dist:android": "bun run build.ts \"--env=VITE_*\" --sourcemap=none && cap sync android && node scripts/gradle-release.cjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "dotenv": "^17.4.2",
    "react": "^19",
    "react-dom": "^19",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "description": "Archivist — compêndio pessoal para escrita acadêmica e criativa",
  "author": "Gabriel Bispo Tolentino",
  "build": {
    "appId": "com.certinho.app",
    "productName": "Archivist",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "dist/**",
      "assets/icon.png",
      ".env",
      "!node_modules/**",
      "node_modules/dotenv/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Archivist-Setup-${version}.exe"
    }
  }
}
